# Copy to api/.env and adjust.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://orienta:orienta@localhost:5432/orienta
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# Sessions. Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CODE_HMAC_KEY=change-me-too
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false

# E-mails (Mailpit in Docker: inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Orienta <no-reply@orienta.local>

# Chatbot model through RodiumAI. LLM_PROVIDER=fake answers with scripted replies (no API key needed).
LLM_PROVIDER=rodiumai
RODIUMAI_API_KEY=
RODIUMAI_MODEL=openai/gpt-4o
LLM_TIMEOUT_SECONDS=60
